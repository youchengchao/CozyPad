{
  "name": "cozypad",
  "private": true,
  "version": "0.3.5",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @cozypad/app dev",
    "dev:desktop": "concurrently -k \"pnpm --filter @cozypad/app dev\" \"pnpm --filter @cozypad/desktop dev\"",
    "dev:desktop:ssh": "concurrently -k \"pnpm --filter @cozypad/app dev\" \"pnpm --filter @cozypad/desktop dev:ssh\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "1.1.14",
    "@types/node": "^26.1.2",
    "@zed-industries/claude-agent-acp": "0.23.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
